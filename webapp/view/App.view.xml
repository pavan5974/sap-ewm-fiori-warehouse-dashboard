<mvc:View
    controllerName="ewm.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        showHeader="false">

        <content>

            <HBox
                height="100%"
                fitContainer="true">

                <VBox width="15rem">

                    <List
                        id="navigationList"
                        mode="SingleSelectMaster"
                        selectionChange=".onNavigationChange"
                        items="{ewm>/navigation}">

                        <items>

                            <StandardListItem
                                title="{ewm>title}"
                                icon="{ewm>icon}"
                                type="Active"/>

                        </items>

                    </List>

                </VBox>

                <VBox
                    width="100%"
                    height="100%">

                    <App id="mainApp"/>

                </VBox>

            </HBox>

        </content>

    </Page>

</mvc:View>