<mvc:View
    controllerName="ewm.controller.Picking"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page title="Picking">
        <content>
            <VBox class="pageMargin">
                <Title text="Picking Operations" level="H2"/>
                <Text text="Monitor picking warehouse tasks and execution status."/>

                <Table items="{ewm>/pickingTasks}">
                    <columns>
                        <Column><Text text="WT"/></Column>
                        <Column><Text text="Delivery"/></Column>
                        <Column><Text text="Product"/></Column>
                        <Column><Text text="Quantity"/></Column>
                        <Column><Text text="Source Bin"/></Column>
                        <Column><Text text="Picker"/></Column>
                        <Column><Text text="Status"/></Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{ewm>warehouseTask}"/>
                                <Text text="{ewm>delivery}"/>
                                <Text text="{ewm>product}"/>
                                <Text text="{ewm>quantity}"/>
                                <Text text="{ewm>sourceBin}"/>
                                <Text text="{ewm>picker}"/>
                                <ObjectStatus text="{ewm>status}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>

</mvc:View>